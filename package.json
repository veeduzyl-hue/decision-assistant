{
  "name": "decision-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node --watch --enable-source-maps dist/server.js",
    "test": "npx -y -p typescript -p @types/node tsc -p tsconfig.json && node --test dist/rules/__tests__/r3_ai_momentum_override.test.js",

    "verify:guardrail": "npm run build && npx tsx scripts/verify_guardrail.ts",
    "release:local": "npm run verify:guardrail"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}


