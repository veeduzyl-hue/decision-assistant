{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "schemas/followup.json",
    "title": "refactor_decision.followup_checklist",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "previous_decision": { "$ref": "common.json#/definitions/Decision" },
          "elapsed_days": { "type": "integer", "minimum": 0 },
          "observations": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lead_time_change": { "type": "string", "enum": ["BETTER", "SAME", "WORSE", "UNKNOWN"], "default": "UNKNOWN" },
              "bug_rate_change": { "type": "string", "enum": ["BETTER", "SAME", "WORSE", "UNKNOWN"], "default": "UNKNOWN" },
              "dev_friction_change": { "type": "string", "enum": ["BETTER", "SAME", "WORSE", "UNKNOWN"], "default": "UNKNOWN" }
            }
          }
        },
        "required": ["previous_decision", "elapsed_days"]
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "retro_questions": { "type": "array", "items": { "type": "string" }, "maxItems": 6 },
          "update_suggestions": { "type": "array", "items": { "type": "string" } },
          "next_decision_hint": { "type": "string" }
        },
        "required": ["retro_questions", "update_suggestions"]
      }
    },
    "required": ["input", "output"]
  }
  