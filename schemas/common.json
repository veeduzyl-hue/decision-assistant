{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "schemas/common.json",
    "title": "Common Schemas",
    "type": "object",
    "definitions": {
      "Decision": {
        "type": "string",
        "enum": ["SHIP", "SCOPED_REFACTOR", "HARD_REFACTOR"]
      },
      "InterventionLevel": {
        "type": "string",
        "enum": ["NONE", "SOFT", "HARD"]
      },
      "Signals": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "structure": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hot_files": { "type": "array", "items": { "type": "string" }, "default": [] },
              "duplicated_logic_hint": { "type": "boolean", "default": false },
              "module_boundary_smell": { "type": "boolean", "default": false }
            },
            "required": ["hot_files"]
          },
          "evolution": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "refactor_days": { "type": "integer", "minimum": 0, "default": 0 },
              "no_user_feature_delivery_days": { "type": "integer", "minimum": 0, "default": 0 },
              "refactor_commits_ratio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
              "refactor_scope_expanding": { "type": "boolean", "default": false },
              "todo_count_in_refactor_area_increasing": { "type": "boolean", "default": false },
  
              "files_touched_per_change_median": { "type": "number", "minimum": 0, "default": 0 },
              "same_module_touch_count_14d": { "type": "integer", "minimum": 0, "default": 0 },
              "rollback_or_rework_events_14d": { "type": "integer", "minimum": 0, "default": 0 },
              "todo_fixme_density_hotspot": { "type": "number", "minimum": 0, "default": 0 },
  
              "decision_file_missing": { "type": "boolean", "default": true },
              "decision_file_invalid": { "type": "boolean", "default": true }
            },
            "required": [
              "refactor_days",
              "no_user_feature_delivery_days",
              "refactor_commits_ratio",
              "files_touched_per_change_median",
              "same_module_touch_count_14d",
              "rollback_or_rework_events_14d",
              "todo_fixme_density_hotspot",
              "decision_file_missing",
              "decision_file_invalid"
            ]
          },
          "complexity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "branching_growth_hint": { "type": "boolean", "default": false },
              "parameter_bloat_hint": { "type": "boolean", "default": false },
              "workaround_comment_hint": { "type": "boolean", "default": false }
            }
          }
        },
        "required": ["structure", "evolution", "complexity"]
      },
      "Answers": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "feature_lead_time_trend": {
            "type": "string",
            "enum": ["DOWN", "FLAT", "UP", "UNKNOWN"],
            "default": "UNKNOWN"
          },
          "fear_of_touching_hotspot": { "type": "boolean", "default": false },
          "expected_next_feature_similarity": {
            "type": "string",
            "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"],
            "default": "UNKNOWN"
          },
          "timebox_weeks": { "type": "integer", "minimum": 1, "maximum": 6, "default": 2 }
        }
      },
      "RepoSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project_name": { "type": "string" },
          "primary_language": { "type": "string" },
          "recent_goal": { "type": "string" }
        }
      },
      "Artifact": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "content": { "type": "string" },
          "format": { "type": "string", "enum": ["markdown"] }
        },
        "required": ["path", "content", "format"]
      },
      "HostAction": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["CREATE_BRANCH", "APPLY_PATCH", "OPEN_FILE", "CREATE_TASKS", "TAG_TODOS"]
          },
          "payload": { "type": "object" }
        },
        "required": ["type", "payload"]
      }
    }
  }
  