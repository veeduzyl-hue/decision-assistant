{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-assistant.local/config/schema/receipt.schema.json",
  "title": "Decision Assistant Receipt Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "plan_hash",
    "nonce",
    "scope"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^gr_[a-f0-9]{12,}$"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^plan_[a-f0-9]{12,}$"
    },
    "nonce": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "const": "this_call_only"
    }
  }
}
