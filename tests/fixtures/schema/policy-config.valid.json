{
  "schema_version": "decision-assistant/policy-config/v1",
  "app": {
    "name": "decision-assistant",
    "version": "1.0.0"
  },
  "mode": "full",
  "rules": {
    "refactor_time_blackhole": {
      "enabled": true,
      "thresholds": {
        "refactor_days_without_ship": 3,
        "refactor_commits_ratio": 0.55,
        "todo_growth_ratio": 0.3,
        "churn_ratio": 0.35
      },
      "weights": {
        "ship_gap": 0.35,
        "refactor_ratio": 0.3,
        "todo_growth": 0.2,
        "churn": 0.15
      },
      "copy": {
        "title": "Refactor drift detected",
        "summary": "Scope should be reduced before execution."
      }
    },
    "ai_momentum_override": {
      "enabled": true,
      "thresholds": {
        "files_touched_warn": 8,
        "diff_lines_warn": 400
      }
    }
  },
  "guardrail": {
    "files_touched": {
      "warn": 8,
      "block": 16
    }
  },
  "storage": {
    "artifacts_dir": "src/artifacts"
  }
}
